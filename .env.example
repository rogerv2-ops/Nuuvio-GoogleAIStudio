# Variables de entorno de seguridad (no subir secretos reales al repositorio)

# --- Autenticacion / sesion ---
# Correo y contrasena del administrador inicial (seed en app_settings.auth_users)
VUUV_ADMIN_EMAIL=admin@example.com
VUUV_ADMIN_PASSWORD=cambiar-esta-contrasena
# Correo y contrasena del usuario comercio inicial
VUUV_COMMERCE_EMAIL=comercio@example.com
VUUV_COMMERCE_PASSWORD=cambiar-esta-contrasena

# --- Webhooks ---
# Meta Cloud API: firma X-Hub-Signature-256 (HMAC SHA-256 con este secreto)
WHATSAPP_APP_SECRET=
# Meta Cloud API: token de verificacion GET hub.verify_token
WHATSAPP_VERIFY_TOKEN=
# WAHA: secreto compartido del webhook (cabecera x-api-key / x-webhook-secret)
WAHA_WEBHOOK_SECRET=

# --- Dominio publico / enlaces de la app ---
# URL publica con la que se arman los enlaces salientes (rutas /c/:ofertaId,
# correos de verificacion y CTA de WhatsApp). Precedencia en el codigo:
#   APP_URL > PUBLIC_URL > COOLIFY_URL > COOLIFY_FQDN > fallback https://yuddit.com
APP_URL=https://yuddit.com
PUBLIC_URL=https://yuddit.com
# Origen exacto permitido para la validacion CSRF de mismo origen (peticionMismoOrigen)
VUUV_PUBLIC_ORIGIN=https://yuddit.com

# --- CORS ---
# Origenes permitidos, separados por coma (dejar vacio = mismo origen)
APP_ALLOWED_ORIGINS=

# --- Tests de contrato (black-box) ---
TEST_BASE_URL=http://localhost:3000


# --- Base de datos PostgreSQL ---
# Conexion de la app a Postgres (en Coolify apuntan al contenedor interno)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
# Activa la capa SQL (true/false). Sin esto la app usa almacenamiento legacy
SQL_USE=true

# --- Cifrado de PII (datos personales en la base) ---
# Clave de 64 caracteres hex para cifrar PII en repos que la usan (src/utils/pii.ts).
# Si falta, la app degrada a texto plano con un console.error: definirla SIEMPRE en produccion.
VUUV_PII_KEY=

# --- IA ---
GEMINI_API_KEY=
# Proveedores opcionales del panel de IA
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- WhatsApp ---
# Modo del conector: waha (local/pruebas) o meta (Cloud API produccion)
WHATSAPP_ACTIVE_MODE=waha
WHATSAPP_DEFAULT_PHONE=
# Meta Cloud API (si WHATSAPP_ACTIVE_MODE=meta)
META_WA_PHONE_NUMBER_ID=
META_WA_WABA_ID=
META_WA_TOKEN=
META_WA_VERIFY_TOKEN=
# WAHA (si WHATSAPP_ACTIVE_MODE=waha)
WAHA_ENDPOINT_URL=
WAHA_API_KEY=
WAHA_SESSION_NAME=

# --- Correo saliente ---
# provider: smtp o resend
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@yuddit.com
EMAIL_FROM_NAME=yuddit
# Resend (si EMAIL_PROVIDER=resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@yuddit.com
RESEND_FROM_NAME=yuddit

# --- Comportamiento de arranque ---
# Sembrar usuarios iniciales si la base esta vacia (false para desactivar)
VUUV_SEED_ON_BOOT=true
# Desactivar MFA (true solo en pruebas; NUNCA en produccion)
VUUV_MFA_DISABLED=false
# Secreto HMAC de sesiones (si falta, se genera y persiste en app_settings)
AUTH_SECRET=
