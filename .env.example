# Variables de entorno de seguridad (no subir secretos reales al repositorio)

# --- Autenticacion / sesion ---
# Correo y contrasena del administrador inicial (seed en app_settings.auth_users)
VUUV_ADMIN_EMAIL=admin@example.com
VUUV_ADMIN_PASSWORD=cambiar-esta-contrasena
# Correo y contrasena del usuario comercio inicial
VUUV_COMMERCE_EMAIL=comercio@example.com
VUUV_COMMERCE_PASSWORD=cambiar-esta-contrasena

# --- Webhooks ---
# Meta Cloud API: firma X-Hub-Signature-256 (HMAC SHA-256 con este secreto)
WHATSAPP_APP_SECRET=
# Meta Cloud API: token de verificacion GET hub.verify_token
WHATSAPP_VERIFY_TOKEN=
# WAHA: secreto compartido del webhook (cabecera x-api-key / x-webhook-secret)
WAHA_WEBHOOK_SECRET=

# --- CORS ---
# Origenes permitidos, separados por coma (dejar vacio = mismo origen)
APP_ALLOWED_ORIGINS=

# --- Tests de contrato (black-box) ---
TEST_BASE_URL=http://localhost:3000
